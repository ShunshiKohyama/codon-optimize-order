# Vendor API credentials — template. Copy to `.env` (git-ignored) and fill in.
#   cp .env.example .env
#
# Only needed for the synthesis-complexity gate. Without them the optimisation
# still runs end to end; the vendor columns are left empty.
#   codon-order-complexity --check-auth     # verify they work
#
# Two independent credential sets for IDT's SciTools Plus API:
#   1. API client — created on IDT's "Request new API key" form
#      (you choose CLIENT_ID on the form; IDT generates the secret)
#   2. Your IDT account login — used at token time (OAuth2 password grant)
#
# Leave these blank here. Real values belong only in `.env`.
IDT_CLIENT_ID=
IDT_CLIENT_SECRET=
IDT_USERNAME=
IDT_PASSWORD=
